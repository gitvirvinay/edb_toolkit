# ============================================================================
# edb_toolkit — SHARED site configuration (used by every module)
#   cp conf/site.env.example conf/site.env     # conf/site.env is git-ignored
#   or generate it on a host:  modules/01-provision/generate-env.sh conf/site.env
# Pass to scripts with:  --env conf/site.env
# ============================================================================

# --- Versions (change here once; every module follows) ---------------------
EPAS_VERSION=17
EFM_VERSION=5.3

# --- Services ---------------------------------------------------------------
SERVICE_NAME="edb-as-${EPAS_VERSION}"
EPAS_SERVICE="${SERVICE_NAME}"              # alias used by 03-patching
EFM_SERVICE="edb-efm-${EFM_VERSION}"

# --- OS account -------------------------------------------------------------
SYSTEM_USER=enterprisedb
SYSTEM_GROUP=enterprisedb

# --- Paths (custom /u001 layout) ---------------------------------------------
SRC_BINARY_DIR="/usr/edb/as${EPAS_VERSION}"
BINARY_TOP="/u001/binary/as${EPAS_VERSION}"
DATA_TOP="/u001/data/as${EPAS_VERSION}"
SECURITY_TOP="${DATA_TOP}/security"          # SSL keys/certs (02-ssl)
PRIMARY_PORT=5444

# --- Cluster identity in the registry (/etc/edb/toolkit/epastab) ------------
CLUSTER_NAME="as${EPAS_VERSION}"             # as<major>, or as<major>_<suffix> for an extra cluster
ENV_TAG=""                                   # DEV | SIT | PAT | PROD (DR of prod = PROD); --tag overrides.
                                             # Empty = epas-base-build-db.sh stops and asks for --tag (never guesses)

# --- Hosts & networking -----------------------------------------------------
PRIMARY_HOST="192.168.1.11"
STANDBY_HOST="192.168.1.12"
SUBNET_CIDR="192.168.1.0/24"
PRIMARY_FQDN=""                              # optional DNS names for SSL certificates (02-ssl)
STANDBY_FQDN=""

# --- Replication ------------------------------------------------------------
REP_USER="repuser"
USE_REPLICATION_SLOT="false"                 # compared as string: "true" enables
CURRENT_HOST="$(hostname -s 2>/dev/null || echo "localhost")"
REP_SLOT_NAME="standby_${CURRENT_HOST}"      # run rebuild-standby ON the standby
# Alternative (same name on primary & standby, independent of where it runs):
# REP_SLOT_NAME="standby_$(echo "$STANDBY_HOST" | tr '.' '_')"

# --- Backup (pgBackRest) / EFM ----------------------------------------------
STANZA=main                                  # pgBackRest stanza (06-backup)
EFM_CLUSTER_NAME=efm                         # EFM cluster name (03-patching, 05-efm)
# EFM_SERVICE: for a cluster not named "efm", 05-efm/efm-setup.sh creates efm-<cluster>.service — set
# EFM_SERVICE="efm-<cluster>" above to match, so 03-patching stops/starts the right agent.
WITNESS_HOST=""                              # EFM witness node (empty = 2-node cluster; needs another agent for failover)
EFM_DB_USER=efm                              # database user the EFM agents connect as
EFM_DB_NAME=edb                              # database the EFM agents connect to
EFM_BIND_PORT=7800                           # EFM agent port (unique per cluster on a node)
EFM_ADMIN_PORT=7809                          # EFM admin port (EDB default 7809; unique per cluster on a node)
EFM_PING_SERVER_IP=""                        # address every node can reach (gateway); empty = template default 8.8.8.8
EFM_USER_EMAIL=""                            # notification e-mail (optional)
VIP_INTERFACE=eth0                           # EFM virtual IP interface (03 rolling patch)
VIP_ADDRESS=                                 # EFM virtual IP; empty = skip VIP checks
VIP_PREFIX=24                                # EFM virtual IP prefix length (with VIP_ADDRESS)

# --- Major upgrade: the OLD cluster (04-upgrade, 02-ssl migrate) -------------
OLD_EPAS_VERSION=15
OLD_SERVICE_NAME="edb-as-${OLD_EPAS_VERSION}"
OLD_SRC_BINARY_DIR="/usr/edb/as${OLD_EPAS_VERSION}"
OLD_DATA_TOP="/u001/data/as${OLD_EPAS_VERSION}"
OLD_PORT=5445                                # used by the dump/restore path (both clusters running)

# --- TDE (openssl passphrase file) -------------------------------------------
# The passphrase lives in a file only the database user can read (dir 0700, file 0400), so
# postgresql.conf (data_encryption_key_unwrap_command) holds the PATH, never the passphrase.
# epas-base-build-root.sh creates TDE_PASS_DIR; epas-base-build-db.sh writes the file from an existing
# file (vault agent / Ansible), $TDE_PASSPHRASE, or a hidden prompt. Never put the passphrase in this file.
# (Thales CipherTrust / KMIP settings go in conf/tde.env; module 08-tde.)
TDE_PASS_DIR=/etc/edb/tde
TDE_PASS_FILE="${TDE_PASS_DIR}/${CLUSTER_NAME}.pass"
TDE_WRAP_CMD="openssl enc -e -aes-128-cbc -pbkdf2 -pass file:${TDE_PASS_FILE} -out %p"
TDE_UNWRAP_CMD="openssl enc -d -aes-128-cbc -pbkdf2 -pass file:${TDE_PASS_FILE} -in %p"
