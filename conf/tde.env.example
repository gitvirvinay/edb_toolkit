# ============================================================================
# edb_toolkit — TDE with Thales CipherTrust Manager (modules/08-tde)
#   cp conf/tde.env.example conf/tde.env       # git-ignored
# Loads conf/site.env first, then adds the Thales/KMIP settings below.
# Pass to scripts with:  --env conf/tde.env
# ============================================================================
_CONF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${_CONF_DIR}/site.env"

# --- Thales CipherTrust Manager (KMIP) --------------------------------------
THALES_HOST=cm.thales.example.com
THALES_PORT=5696
THALES_USER=edb-kmip-user
THALES_PASS="${THALES_PASS:-<inject from secrets manager>}"
THALES_KEY_UUID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx   # for migration: the NEW key
THALES_KEYFILE=/path/to/key.pem
THALES_CERTFILE=/path/to/cert.pem
THALES_CAFILE=/path/to/ca.pem

# --- EPAS data directory for the key-wrap helper ----------------------------
DSM_DIR=/var/lib/edb/dsm

# --- Only for tde-openssl-to-thales-migrate.sh ------------------------------
# By default the current key is unwrapped with the server's own data_encryption_key_unwrap_command.
# Override only if needed (must contain %p), e.g.:
# OLD_UNWRAP_CMD='openssl enc -d -aes-128-cbc -pbkdf2 -pass env:OLD_TDE_PASSPHRASE -in "%p"'
OLD_TDE_PASSPHRASE="${OLD_TDE_PASSPHRASE:-<from secrets manager>}"   # only used by a command like the one above
