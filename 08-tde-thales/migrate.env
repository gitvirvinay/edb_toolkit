# Old openssl TDE
OLD_TDE_PASSPHRASE='<from secrets manager>'

# Thales CM (new)
THALES_HOST=cm.thales.example.com
THALES_PORT=5696
THALES_USER=edb-kmip-user
THALES_PASS='<from secrets manager>'
THALES_KEY_UUID=yyyyyyyy-yyyy-yyyy-yyyy-yyyyyyyyyyyy   # NEW key on Thales
THALES_KEYFILE=/path/to/key.pem
THALES_CERTFILE=/path/to/cert.pem
THALES_CAFILE=/path/to/ca.pem

# EPAS
EPAS_VERSION=17
SYSTEM_USER=enterprisedb
SYSTEM_GROUP=enterprisedb
PRIMARY_PORT=5444
DATA_TOP=/var/lib/edb-as/17/data
DSM_DIR=/var/lib/edb/dsm